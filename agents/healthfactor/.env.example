# Copy ke .studio/.env.local lalu: chmod 600 .studio/.env.local
# Jangan commit .studio/ — seluruh folder itu gitignored.
# bag memuat file ini otomatis dari root workspace agent (bukan dari app/agent/).

# Wajib sebelum `bag wallet new` — isi sendiri, jangan tempel di chat.
WALLET_PASSWORD=

# 9router — https://github.com/decolua/9router
# Key dari dashboard 9router. Base URL = host kamu + /v1
# Lokal default: http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=
# bag doctor membaca nama ini — samakan isinya dengan NINEROUTER_API_KEY
OPENAI_API_KEY=

# Port utama kalau menjalankan lebih dari satu agent di mesin yang sama.
AGENT_PORT=9001

# conservative | aggressive
AGENT_VARIANT=conservative

# Opsional. Tanpa ini, GET /strategy idle: tidak ada session user untuk tx Venus/PCS.
# Isi setelah: cd app/agent && pnpm grant-user-session
# USER_SESSION_FILE=
# USER_SESSIONS_DIR=
# TICK_INTERVAL_MS=120000
# STRATEGY_NOTIONAL_WEI=10000000000000000
# BNB_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
