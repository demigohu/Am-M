# Copy ke .studio/.env.local lalu: chmod 600 .studio/.env.local
# Jangan commit .studio/ — seluruh folder itu gitignored.

WALLET_PASSWORD=

# 9router — https://github.com/decolua/9router
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=
OPENAI_API_KEY=

AGENT_PORT=9004
AGENT_VARIANT=conservative

# Isi setelah: cd app/agent && pnpm grant-user-session
